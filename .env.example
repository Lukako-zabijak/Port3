# Only needed for the live price estimator endpoint (api/estimate.ts).
# Without it the estimator still answers using its built-in pricing engine.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional but recommended in Vercel production for a consistent per-client
# five-minute estimate cooldown across serverless instances. Without it, the
# endpoint uses a best-effort per-instance cooldown instead of being disabled.
KV_REST_API_URL="https://YOUR-REDIS-INSTANCE.upstash.io"
KV_REST_API_TOKEN="YOUR_REDIS_REST_TOKEN"
