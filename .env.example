# Only needed for the live price estimator endpoint (api/estimate.ts).
# Without it the estimator still answers using its built-in pricing engine.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required in Vercel production for the per-client five-minute estimate cooldown.
# Create an Upstash Redis database through Vercel, then add both values to Vercel.
KV_REST_API_URL="https://YOUR-REDIS-INSTANCE.upstash.io"
KV_REST_API_TOKEN="YOUR_REDIS_REST_TOKEN"
